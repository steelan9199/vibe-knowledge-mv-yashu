  "lyrics": [
    { "text": "纸做的月亮",   "start": 0.2,  "end": 3.7 },
    { "text": "也会落进海里", "start": 4.0,  "end": 7.3 },
    { "text": "我提着灯",     "start": 7.7,  "end": 11.0 },
    { "text": "往你那边走",   "start": 11.3, "end": 14.6 },
    { "text": "风把浪举高",   "start": 15.0, "end": 18.2 },
    { "text": "又轻轻放回",   "start": 18.5, "end": 21.7 },
    { "text": "灯一盏一盏",   "start": 22.2, "end": 25.6 },
    { "text": "亮在你眼里",   "start": 26.0, "end": 29.5 },
    { "text": "码头上的人",   "start": 30.0, "end": 33.2 },
    { "text": "都在说再见",   "start": 33.6, "end": 37.0 },
    { "text": "幕从两边撕开", "start": 37.4, "end": 40.6 },
    { "text": "海在缝里漏光", "start": 41.0, "end": 44.4 },
    { "text": "我把灯放开",   "start": 44.8, "end": 48.1 },
    { "text": "让它去找你",   "start": 48.5, "end": 51.8 },
    { "text": "月亮低下头",   "start": 52.2, "end": 55.5 },
    { "text": "你也低下头",   "start": 55.9, "end": 59.4 }
